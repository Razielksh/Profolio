meta {
  name: ERR - 03 Registro con Contraseña Inválida (400 - Bean Validation)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Test User",
    "email": "test@example.com",
    "password": "1234"
  }
}

tests {
  test("Status es 400 Bad Request por contraseña débil", function() {
    expect(res.status).to.equal(400);
  });

  test("Respuesta contiene errores de campo (Bean Validation)", function() {
    expect(res.body.fieldErrors).to.exist;
    expect(res.body.fieldErrors.password).to.be.a("string");
  });

  test("Mensaje de error de contraseña es descriptivo", function() {
    expect(res.body.fieldErrors.password).to.include("mayúscula");
  });
}
